# Copy this file to .env and fill in what you need. Never commit .env.

# Optional. Without a key the agent runs with the built-in rules brain (fully offline).
ANTHROPIC_API_KEY=

# Which "brain" decides:  rules | llm | auto  (auto = llm if a key exists, else rules)
AGENT_BRAIN=auto

# LLM model used when the brain is "llm"
LLM_MODEL=claude-sonnet-5-5

# Business policy knobs
REVIEW_PERIOD_DAYS=7
APPROVAL_THRESHOLD=10000
